server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The Go API listens on the loopback interface only.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = /health {
        proxy_pass http://127.0.0.1:8081;
    }

    location = /config {
        proxy_pass http://127.0.0.1:8081;
    }

    location = /available-slots {
        proxy_pass http://127.0.0.1:8081;
    }

    location = /bookings {
        proxy_pass http://127.0.0.1:8081;
    }

    # /meeting-types is both an API path and an SPA route. Browser navigation
    # sends Accept: text/html, so it must receive the SPA shell; the API client
    # asks for JSON and is proxied to the backend.
    location = /meeting-types {
        if ($http_accept ~* "text/html") {
            rewrite ^ /index.html last;
        }

        proxy_pass http://127.0.0.1:8081;
    }

    # Deep links and client-side routes fall back to the SPA shell.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
